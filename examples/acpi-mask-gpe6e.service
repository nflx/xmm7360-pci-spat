[Unit]
Description=Mask ACPI GPE 0x6E and RP02 wake GPE 0x6F from Intel XMM7360 LTE modem
# The XMM7360 modem generates a continuous GPE 0x6E storm (~600k events/session)
# and RP02 raises GPE 0x6F as Device Wake. Both wake the system from s2idle.
# Masking them here is belt-and-suspenders alongside the sleep hook which
# removes the PCIe device before suspend.
After=systemd-udevd.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'grep -qw masked /sys/firmware/acpi/interrupts/gpe6E || echo mask > /sys/firmware/acpi/interrupts/gpe6E; grep -qw masked /sys/firmware/acpi/interrupts/gpe6F || echo mask > /sys/firmware/acpi/interrupts/gpe6F'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
